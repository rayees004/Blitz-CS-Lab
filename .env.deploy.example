# Deployment Configuration Example
# Copy this file to .env.deploy and fill in your actual credentials.
# Note: .env.deploy is ignored by git and will never be committed.

CPANEL_SSH_HOST=decodexe.com
CPANEL_SSH_PORT=22
CPANEL_SSH_USER=decodexe
CPANEL_SSH_PASSWORD=your_password_here
# Or SSH Key path:
# CPANEL_SSH_KEY_PATH=C:/Users/LENOVO/.ssh/id_rsa
